{
  "name": "idlewild-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "node scripts/check-ui.mjs",
    "check": "npm test && npm run build && npm run test:ui"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "@smartspectra/node-sdk": "3.5.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.0.0",
    "@types/three": "^0.187.0",
    "electron": "45.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
